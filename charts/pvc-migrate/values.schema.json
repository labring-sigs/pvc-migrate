{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "toolImage", "serviceAccount", "rbac", "controller", "resources", "podDisruptionBudget"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "nameOverride": {"$ref": "#/definitions/name"},
    "fullnameOverride": {"$ref": "#/definitions/name"},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^\\s@]+$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"$ref": "#/definitions/tag"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
      }
    },
    "toolImage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[^\\s@]*$"},
        "tag": {"$ref": "#/definitions/tag"}
      }
    },
    "serviceAccount": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "annotations": {"$ref": "#/definitions/strings"},
        "name": {"type": "string", "not": {"const": "default"}}
      }
    },
    "rbac": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "kubeBlocksMongoDBNamespaces": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
        }
      }
    },
    "controller": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "logLevel": {"enum": ["debug", "info", "warn", "error"]},
        "logFormat": {"enum": ["json", "text"]},
        "operationTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}
      }
    },
    "podAnnotations": {"$ref": "#/definitions/strings"},
    "podLabels": {"$ref": "#/definitions/strings"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "startupProbe": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "podDisruptionBudget": {
      "type": "object", "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 1}}
    },
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"$ref": "#/definitions/strings"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}}
  },
  "definitions": {
    "name": {"type": "string", "maxLength": 40, "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"},
    "tag": {"type": "string", "maxLength": 128, "pattern": "^([a-zA-Z0-9_][a-zA-Z0-9_.-]*)?$", "not": {"enum": ["latest", "dev"]}},
    "strings": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
